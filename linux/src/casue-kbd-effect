#!/bin/bash
# Pick a lighting effect for the CASUE keyboard backlight (no sudo needed).
MODES="steady off slow pulse breathe aurora heartbeat strobe candle sos typing cpu disk net"
case "${1:-}" in
  "")
    echo "current: $(cat /run/casue-kbd-effect 2>/dev/null || echo steady)"
    echo "modes:   $MODES"
    ;;
  steady|off|slow|pulse|breathe|aurora|heartbeat|strobe|candle|sos|typing|cpu|disk|net)
    printf '%s' "$1" > /run/casue-kbd-effect || exit 1
    echo "keyboard effect: $1"
    ;;
  *)
    echo "usage: casue-kbd-effect [mode]"
    echo "modes: $MODES"
    exit 1
    ;;
esac
